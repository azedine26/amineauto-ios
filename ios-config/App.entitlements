<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Push notifications (FCM → APNs). Use "development" for a debug build. -->
  <key>aps-environment</key>
  <string>production</string>
  <!-- Universal Links: taps on https://amineauto.com/... open the app.
       Requires the AASA file live at amineauto.com/.well-known/apple-app-site-association. -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:amineauto.com</string>
  </array>
</dict>
</plist>
