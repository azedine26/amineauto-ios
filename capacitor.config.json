{
  "appId": "com.amineauto.app",
  "appName": "AmineAuto",
  "webDir": "www",
  "server": {
    "url": "https://amineauto.com",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}